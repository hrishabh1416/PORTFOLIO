# Environment variables — copy this file to .env and fill in your real credentials
# NEVER commit the actual .env file to Git

# ── SMTP Configuration ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_EMAIL=your-gmail-address@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000

# ── CORS — set to the URL where your portfolio frontend is served ───────────────
# Examples:
#   For local development: http://127.0.0.1:5500
#   For GitHub Pages:      https://yourusername.github.io
#   For a custom domain:   https://yourportfolio.com
FRONTEND_ORIGIN=http://127.0.0.1:5500
